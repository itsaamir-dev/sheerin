# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default for local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production)
# DATABASE_URL="postgresql://user:password@localhost:5432/sweetcake"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-string-in-production"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number in international format (no + sign, no spaces)
# e.g. for +91 98765 43210 → 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# ── Stripe (optional — for online card payments) ───────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
